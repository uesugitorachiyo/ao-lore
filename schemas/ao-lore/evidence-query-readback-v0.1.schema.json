{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/evidence-query-readback-v0.1.schema.json", "$comment": "Shape only. Product consumers must bind graph_digest and evidence_ids to an independently validated graph manifest with the context-aware runtime validator.", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "query_id", "prompt_digest", "graph_digest", "outcome", "evidence_ids", "authority_roles", "qualifications", "readback_digest", "legal_advice", "property_decision", "candidate_review", "candidate_decision", "promotion", "canonical_query", "provider", "credential", "private_data", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.evidence-query-readback.v0.1"}, "query_id": {"$ref": "#/$defs/id"}, "prompt_digest": {"$ref": "#/$defs/digest"}, "graph_digest": {"$ref": "#/$defs/digest"}, "outcome": {"enum": ["answer", "partial", "refuse", "investigate"]},
    "evidence_ids": {"type": "array", "minItems": 0, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "authority_roles": {"type": "array", "minItems": 0, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/role"}},
    "qualifications": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/public_text"}}, "readback_digest": {"$ref": "#/$defs/digest"},
    "legal_advice": {"const": false}, "property_decision": {"const": false}, "candidate_review": {"const": false}, "candidate_decision": {"const": false}, "promotion": {"const": false}, "canonical_query": {"const": false}, "provider": {"const": false}, "credential": {"const": false}, "private_data": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  }, "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "role": {"enum": ["primary_law", "official_interpretation", "local_enforcement_guidance", "technical_guidance", "operator_procedure", "case_evidence"]}, "public_text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!.*[\\u0000-\\u001f])(?!/|[Ff][Ii][Ll][Ee]:)(?!.*(?:/[Hh][Oo][Mm][Ee]/|/[Oo][Pp][Tt]/|\\\\)).+$"}}
}
