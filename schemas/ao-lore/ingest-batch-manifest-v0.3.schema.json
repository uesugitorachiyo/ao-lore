{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/ingest-batch-manifest-v0.3.schema.json",
  "title": "AO Lore OCR Ingest Batch Manifest v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "format_id", "media_type", "parser_id",
    "parser_version", "documents", "continue_on_error"
  ],
  "properties": {
    "schema_version": {"const": "ao.lore.ingest-batch-manifest.v0.3"},
    "batch_id": {"type": "string", "pattern": "^batch-[a-z0-9][a-z0-9-]{0,62}$"},
    "format_id": {"const": "ocr"},
    "media_type": {"const": "application/pdf"},
    "parser_id": {"const": "paddle-ocr-english"},
    "parser_version": {"const": "0.1.0"},
    "documents": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_id", "source", "source_digest"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "source": {
            "type": "string", "minLength": 13, "maxLength": 1024,
            "pattern": "^sources/(?!\\.\\.?/)(?!.*(?:/\\.\\.?)(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.pdf$"
          },
          "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "candidate_context": {"$ref": "ingest-batch-manifest-v0.2.schema.json#/$defs/candidate_context"}
        }
      }
    },
    "continue_on_error": {"const": true}
  }
}
