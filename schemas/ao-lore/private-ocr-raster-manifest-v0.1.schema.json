{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/private-ocr-raster-manifest-v0.1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "policy_digest", "source_id", "source_digest", "configuration_digest", "renderer_digest", "dpi", "pages", "network_accessed", "provider_calls", "promotion", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.private-ocr-raster-manifest.v0.1"},
    "policy_digest": {"const": "sha256:fe17335189fcf75471d0adb3251e14a34c7e16cb66071e90361e50d77b6c7e20"},
    "source_id": {"$ref": "#/$defs/id"}, "source_digest": {"$ref": "#/$defs/digest"},
    "configuration_digest": {"$ref": "#/$defs/digest"}, "renderer_digest": {"$ref": "#/$defs/digest"},
    "dpi": {"const": 300},
    "pages": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/page"}},
    "network_accessed": {"const": false}, "provider_calls": {"const": false},
    "promotion": {"const": false}, "publication": {"const": false},
    "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "page": {"type": "object", "additionalProperties": false, "required": ["page_id", "width", "height", "size", "digest"], "properties": {
      "page_id": {"$ref": "#/$defs/id"}, "width": {"type": "integer", "minimum": 1, "maximum": 25000000},
      "height": {"type": "integer", "minimum": 1, "maximum": 25000000},
      "size": {"type": "integer", "minimum": 1, "maximum": 104857600}, "digest": {"$ref": "#/$defs/digest"}
    }}
  }
}
