{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/candidate-quality-sampling-policy-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "campaign_id",
    "terminal_readback_digest",
    "total_candidate_count",
    "total_claim_count",
    "total_sample_count",
    "allocations",
    "selection_priority",
    "policy_digest",
    "canonical_query_invoked",
    "review_event_appended",
    "candidate_decision_taken",
    "promotion_prepared",
    "promotion_applied",
    "provider_calls",
    "network_accessed",
    "credential_used",
    "publication",
    "release",
    "deployment",
    "authority_advanced"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.lore.candidate-quality-sampling-policy.v0.1"
    },
    "policy_id": {
      "$ref": "#/$defs/identifier"
    },
    "campaign_id": {
      "$ref": "#/$defs/identifier"
    },
    "terminal_readback_digest": {
      "$ref": "#/$defs/digest"
    },
    "total_candidate_count": {
      "type": "integer",
      "const": 6
    },
    "total_claim_count": {
      "type": "integer",
      "const": 486
    },
    "total_sample_count": {
      "type": "integer",
      "const": 96
    },
    "allocations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "candidate_digest",
          "provenance_digest",
          "source_digest",
          "claim_count",
          "sample_count"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "#/$defs/identifier"
          },
          "candidate_digest": {
            "$ref": "#/$defs/digest"
          },
          "provenance_digest": {
            "$ref": "#/$defs/digest"
          },
          "source_digest": {
            "$ref": "#/$defs/digest"
          },
          "claim_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 486
          },
          "sample_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 96
          }
        }
      }
    },
    "selection_priority": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "enum": [
          "binding_risk",
          "normalized_duplicate",
          "fragmentation",
          "position",
          "length",
          "block_type",
          "digest_fill"
        ]
      }
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "canonical_query_invoked": {
      "const": false
    },
    "review_event_appended": {
      "const": false
    },
    "candidate_decision_taken": {
      "const": false
    },
    "promotion_prepared": {
      "const": false
    },
    "promotion_applied": {
      "const": false
    },
    "provider_calls": {
      "const": false
    },
    "network_accessed": {
      "const": false
    },
    "credential_used": {
      "const": false
    },
    "publication": {
      "const": false
    },
    "release": {
      "const": false
    },
    "deployment": {
      "const": false
    },
    "authority_advanced": {
      "const": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
