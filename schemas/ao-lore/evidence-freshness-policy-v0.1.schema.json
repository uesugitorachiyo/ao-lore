{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/evidence-freshness-policy-v0.1.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "policy_id", "bundle_id", "graph_id", "graph_digest", "source_registry_digest", "verification_interval_seconds", "maximum_observation_age_seconds", "maximum_observation_bytes", "maximum_redirect_hops", "allowed_media_types", "allowed_terminal_classifications", "sources", "policy_digest", "legal_advice", "property_decision", "candidate_review", "candidate_decision", "promotion", "canonical_query", "provider", "credential", "private_data", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.evidence-freshness-policy.v0.1"}, "policy_id": {"$ref": "#/$defs/id"}, "bundle_id": {"$ref": "#/$defs/id"}, "graph_id": {"$ref": "#/$defs/id"}, "graph_digest": {"$ref": "#/$defs/digest"}, "source_registry_digest": {"$ref": "#/$defs/digest"},
    "verification_interval_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
    "maximum_observation_age_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
    "maximum_observation_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}, "maximum_redirect_hops": {"type": "integer", "minimum": 0, "maximum": 8},
    "allowed_media_types": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/media_type"}},
    "allowed_terminal_classifications": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["unchanged", "updated", "superseded", "unavailable", "investigate"]}},
    "sources": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "canonical_locator", "prior_record_digest", "prior_content_digest", "prior_media_type", "declared_successor_locator"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "canonical_locator": {"$ref": "#/$defs/locator"}, "prior_record_digest": {"$ref": "#/$defs/digest"}, "prior_content_digest": {"$ref": "#/$defs/digest"}, "prior_media_type": {"$ref": "#/$defs/media_type"}, "declared_successor_locator": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locator"}]}}}},
    "policy_digest": {"$ref": "#/$defs/digest"}, "legal_advice": {"const": false}, "property_decision": {"const": false}, "candidate_review": {"const": false}, "candidate_decision": {"const": false}, "promotion": {"const": false}, "canonical_query": {"const": false}, "provider": {"const": false}, "credential": {"const": false}, "private_data": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "media_type": {"type": "string", "maxLength": 192, "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,127}$"}, "locator": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?!.*[\\u0000-\\u001f\\u007f-\\u009f])(?!.*\\s$)https:\\/\\/(?!(?:(?:0x[0-9a-f]+|[0-9]+)\\.)*(?:0x[0-9a-f]+|[0-9]+)(?::443)?/)(?=[^/:?#]{1,253}(?::443)?/)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::443)?/(?=[^?#]{0,1023}(?:\\?|$))[^#]*$"}}
}
