{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/workspace-registry-inspection-v0.1.schema.json", "$comment": "Shape only; bind to a validated registry generation with the runtime validator.", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "inspection_id", "registry_id", "registry_digest", "sequence", "status", "reason_code", "workspace_ids", "workspace_count", "active_count", "inactive_count", "investigate_count", "inspection_digest", "legal_advice", "property_decision", "candidate_review", "candidate_decision", "promotion", "canonical_query", "provider", "credential", "private_data", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.workspace-registry-inspection.v0.1"}, "inspection_id": {"$ref": "#/$defs/id"}, "registry_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "registry_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "sequence": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "status": {"enum": ["active", "inactive", "investigate", "empty"]}, "reason_code": {"$ref": "#/$defs/reason_code"}, "workspace_ids": {"type": "array", "minItems": 0, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "workspace_count": {"$ref": "#/$defs/count"}, "active_count": {"$ref": "#/$defs/count"}, "inactive_count": {"$ref": "#/$defs/count"}, "investigate_count": {"$ref": "#/$defs/count"}, "inspection_digest": {"$ref": "#/$defs/digest"},
    "legal_advice": {"const": false}, "property_decision": {"const": false}, "candidate_review": {"const": false}, "candidate_decision": {"const": false}, "promotion": {"const": false}, "canonical_query": {"const": false}, "provider": {"const": false}, "credential": {"const": false}, "private_data": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["active", "empty"]}}, "required": ["status"]}, "then": {"properties": {"reason_code": {"const": "ok"}}}, "else": {"properties": {"reason_code": {"not": {"const": "ok"}}}}},
    {"if": {"properties": {"status": {"const": "empty"}}, "required": ["status"]}, "then": {"properties": {"registry_id": {"type": "null"}, "registry_digest": {"type": "null"}, "sequence": {"const": 0}, "workspace_ids": {"maxItems": 0}, "workspace_count": {"const": 0}, "active_count": {"const": 0}, "inactive_count": {"const": 0}, "investigate_count": {"const": 0}}}, "else": {"properties": {"registry_id": {"$ref": "#/$defs/id"}, "registry_digest": {"$ref": "#/$defs/digest"}, "sequence": {"minimum": 1}}}}
  ],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 64}, "reason_code": {"enum": ["ok", "workspace_unknown", "workspace_inactive", "registry_invalid", "identity_collision", "reference_not_declared", "reference_cycle", "workspace_binding_drift", "freshness_investigation_required", "recovery_pending"]}}
}
