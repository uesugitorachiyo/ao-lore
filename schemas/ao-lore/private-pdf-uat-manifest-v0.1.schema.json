{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/private-pdf-uat-manifest-v0.1.schema.json",
  "title": "AO Lore Private PDF UAT Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "block_type": {
      "enum": [
        "heading",
        "paragraph",
        "list",
        "table",
        "code",
        "image",
        "caption",
        "footnote",
        "link"
      ]
    },
    "expected_text": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "file",
        "source_digest",
        "expected_text",
        "required_block_types"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/identifier"
        },
        "file": {
          "type": "string",
          "minLength": 5,
          "maxLength": 256,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.pdf$"
        },
        "source_digest": {
          "$ref": "#/$defs/digest"
        },
        "expected_text": {
          "$ref": "#/$defs/expected_text"
        },
        "required_block_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/block_type"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "parser_id",
    "parser_version",
    "ocr_enabled",
    "documents",
    "provider_calls",
    "promotion_authority",
    "claims_authority_advance"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.lore.private-pdf-uat-manifest.v0.1"
    },
    "corpus_id": {
      "$ref": "#/$defs/identifier"
    },
    "parser_id": {
      "const": "docling"
    },
    "parser_version": {
      "const": "2.118.1"
    },
    "ocr_enabled": {
      "const": false
    },
    "documents": {
      "$comment": "Runtime also enforces ordered private-root containment by preserving the caller-supplied validated document sequence, plus unique item_id and file bindings, duplicate expected_text anchor rejection across documents, and duplicate normalized required_block_types set rejection across documents.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "provider_calls": {
      "const": false
    },
    "promotion_authority": {
      "const": false
    },
    "claims_authority_advance": {
      "const": false
    }
  }
}
