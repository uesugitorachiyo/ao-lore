{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/workspace-query-readback-v0.2.schema.json", "$comment": "Shape only; runtime binds every origin to exact selected document and graph generations.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "query_id", "prompt_digest", "registry_id", "registry_digest", "primary_workspace_id", "consulted_workspace_ids", "outcome", "reason_code", "evidence", "qualifications", "readback_digest", "legal_advice", "property_decision", "candidate_review", "candidate_decision", "promotion", "canonical_query", "provider", "credential", "private_data", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.workspace-query-readback.v0.2"}, "query_id": {"$ref": "#/$defs/id"}, "prompt_digest": {"$ref": "#/$defs/digest"}, "registry_id": {"$ref": "#/$defs/id"}, "registry_digest": {"$ref": "#/$defs/digest"}, "primary_workspace_id": {"$ref": "#/$defs/id"}, "consulted_workspace_ids": {"type": "array", "minItems": 1, "maxItems": 17, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "outcome": {"enum": ["answer", "partial", "refuse", "investigate"]}, "reason_code": {"$ref": "#/$defs/id"}, "evidence": {"type": "array", "minItems": 0, "maxItems": 128, "uniqueItems": true, "items": {"oneOf": [{"$ref": "#/$defs/document_evidence"}, {"$ref": "#/$defs/graph_evidence"}]}}, "qualifications": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/public_text"}}, "readback_digest": {"$ref": "#/$defs/digest"},
    "legal_advice": {"const": false}, "property_decision": {"const": false}, "candidate_review": {"const": false}, "candidate_decision": {"const": false}, "promotion": {"const": false}, "canonical_query": {"const": false}, "provider": {"const": false}, "credential": {"const": false}, "private_data": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "document_id": {"type": "string", "pattern": "^(?:sha256:[0-9a-f]{64}|[a-z0-9][a-z0-9._-]{0,127})$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "public_text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!.*[\\u0000-\\u001f])(?!/|[Ff][Ii][Ll][Ee]:)(?!.*(?:/[Hh][Oo][Mm][Ee]/|/[Oo][Pp][Tt]/|/[Tt][Mm][Pp]/|\\\\)).+$"}, "document_evidence": {"type": "object", "additionalProperties": false, "required": ["workspace_id", "document_store_id", "generation_digest", "document_id", "source_id", "evidence_kind", "evidence_id", "evidence_digest"], "properties": {"workspace_id": {"$ref": "#/$defs/id"}, "document_store_id": {"$ref": "#/$defs/id"}, "generation_digest": {"$ref": "#/$defs/digest"}, "document_id": {"$ref": "#/$defs/document_id"}, "source_id": {"$ref": "#/$defs/id"}, "evidence_kind": {"const": "document_block"}, "evidence_id": {"$ref": "#/$defs/digest"}, "evidence_digest": {"$ref": "#/$defs/digest"}}}, "graph_evidence": {"type": "object", "additionalProperties": false, "required": ["workspace_id", "graph_id", "source_id", "evidence_kind", "evidence_id", "evidence_digest"], "properties": {"workspace_id": {"$ref": "#/$defs/id"}, "graph_id": {"$ref": "#/$defs/id"}, "source_id": {"$ref": "#/$defs/id"}, "evidence_kind": {"enum": ["graph_claim", "graph_edge"]}, "evidence_id": {"$ref": "#/$defs/id"}, "evidence_digest": {"$ref": "#/$defs/digest"}}}}
}
