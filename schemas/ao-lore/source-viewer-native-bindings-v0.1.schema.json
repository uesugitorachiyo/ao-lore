{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/source-viewer-native-bindings-v0.1.schema.json",
  "$comment": "Expiring whole-original approval input for native retained-source resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "primary_workspace_id", "reference_workspace_ids", "registry_digest", "provenance_mode", "records"],
  "properties": {
    "schema_version": {"const": "ao.lore.source-viewer-native-bindings.v0.1"},
    "primary_workspace_id": {"$ref": "#/$defs/id"},
    "reference_workspace_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "registry_digest": {"$ref": "#/$defs/digest"},
    "provenance_mode": {"const": "native-retained-source"},
    "records": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence", "format", "original_sensitivity", "pdf_page_basis"],
      "properties": {
        "evidence": {"$ref": "workspace-document-query-readback-v0.1.schema.json#/$defs/evidence"},
        "format": {"enum": ["pdf", "docx"]},
        "original_sensitivity": {"enum": ["public", "internal"]},
        "pdf_page_basis": {"enum": ["physical-one-based", "not-applicable"]}
      }
    }
  }
}
