{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/evidence-campaign-summary-v0.1.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "correlation_id", "registry_digest", "graph_digest", "inspection_digest", "uat_digest", "source_count", "claim_count", "edge_count", "question_count", "passed_question_count", "refused_question_count", "investigate_question_count", "zero_orphans", "summary_digest", "legal_advice", "property_decision", "candidate_review", "candidate_decision", "promotion", "canonical_query", "provider", "credential", "private_data", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.evidence-campaign-summary.v0.1"}, "campaign_id": {"$ref": "#/$defs/id"}, "correlation_id": {"$ref": "#/$defs/id"}, "registry_digest": {"$ref": "#/$defs/digest"}, "graph_digest": {"$ref": "#/$defs/digest"}, "inspection_digest": {"$ref": "#/$defs/digest"}, "uat_digest": {"$ref": "#/$defs/digest"},
    "source_count": {"type": "integer", "minimum": 0, "maximum": 16}, "claim_count": {"type": "integer", "minimum": 0, "maximum": 512}, "edge_count": {"type": "integer", "minimum": 0, "maximum": 2048}, "question_count": {"type": "integer", "minimum": 0, "maximum": 32}, "passed_question_count": {"type": "integer", "minimum": 0, "maximum": 32}, "refused_question_count": {"type": "integer", "minimum": 0, "maximum": 32}, "investigate_question_count": {"type": "integer", "minimum": 0, "maximum": 32}, "zero_orphans": {"const": true}, "summary_digest": {"$ref": "#/$defs/digest"},
    "legal_advice": {"const": false}, "property_decision": {"const": false}, "candidate_review": {"const": false}, "candidate_decision": {"const": false}, "promotion": {"const": false}, "canonical_query": {"const": false}, "provider": {"const": false}, "credential": {"const": false}, "private_data": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  }, "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
