{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/evidence-selection-authorization-v0.1.schema.json",
  "title": "AO Lore Evidence Selection Authorization v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "proposal_id",
    "proposal_digest",
    "operation",
    "operator_id",
    "nonce",
    "source_head",
    "issued_at",
    "expires_at",
    "candidate_creation",
    "one_use_only",
    "product_self_issued",
    "legal_advice",
    "property_decision",
    "candidate_review",
    "candidate_decision",
    "promotion",
    "canonical_query",
    "provider",
    "credential",
    "private_data",
    "publication",
    "release",
    "deployment",
    "authority_advanced",
    "authorization_digest"
  ],
  "properties": {
    "schema_version": {"const": "ao.lore.evidence-selection-authorization.v0.1"},
    "authorization_id": {"$ref": "#/$defs/id"},
    "proposal_id": {"$ref": "#/$defs/id"},
    "proposal_digest": {"$ref": "#/$defs/digest"},
    "operation": {"const": "apply"},
    "operator_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "nonce": {"$ref": "#/$defs/id"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "issued_at": {"$ref": "#/$defs/time"},
    "expires_at": {"$ref": "#/$defs/time"},
    "candidate_creation": {"const": true},
    "one_use_only": {"const": true},
    "product_self_issued": {"const": false},
    "legal_advice": {"const": false},
    "property_decision": {"const": false},
    "candidate_review": {"const": false},
    "candidate_decision": {"const": false},
    "promotion": {"const": false},
    "canonical_query": {"const": false},
    "provider": {"const": false},
    "credential": {"const": false},
    "private_data": {"const": false},
    "publication": {"const": false},
    "release": {"const": false},
    "deployment": {"const": false},
    "authority_advanced": {"const": false},
    "authorization_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "time": {"type": "string", "format": "date-time", "maxLength": 32}
  }
}
