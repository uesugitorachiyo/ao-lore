{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/knowledge-search-readback-v0.2.schema.json", "title": "AO Lore Knowledge Search Readback v0.2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "snapshot_digest", "query_digest", "hits", "legacy_v0_2_entry_count", "answerable_v0_3_entry_count", "answerable_v0_4_entry_count"],
  "properties": {"schema_version": {"const": "ao.lore.knowledge-search-readback.v0.2"}, "status": {"const": "completed"}, "snapshot_digest": {"$ref": "#/$defs/digest"}, "query_digest": {"$ref": "#/$defs/digest"}, "hits": {"type": "array", "maxItems": 200, "items": {"oneOf": [{"$ref": "#/$defs/answerable_v03"}, {"$ref": "#/$defs/answerable_v04"}, {"$ref": "#/$defs/metadata"}]}}, "legacy_v0_2_entry_count": {"$ref": "#/$defs/count"}, "answerable_v0_3_entry_count": {"$ref": "#/$defs/count"}, "answerable_v0_4_entry_count": {"type": "integer", "minimum": 1, "maximum": 10000}},
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "origin_identity": {"type": "object", "additionalProperties": false, "required": ["workspace_id", "evidence_kind", "evidence_id", "evidence_digest"], "properties": {"workspace_id": {"$ref": "#/$defs/id"}, "evidence_kind": {"enum": ["document_block", "graph_claim", "graph_edge"]}, "evidence_id": {"type": "string", "pattern": "^(?:sha256:[0-9a-f]{64}|[a-z0-9][a-z0-9._-]{0,127})$"}, "evidence_digest": {"$ref": "#/$defs/digest"}}},
    "score": {"type": "object", "additionalProperties": false, "required": ["claim_exact_match", "claim_substring_match", "matched_claim_token_count", "matched_citation_token_count"], "properties": {"claim_exact_match": {"type": "boolean"}, "claim_substring_match": {"type": "boolean"}, "matched_claim_token_count": {"type": "integer", "minimum": 0, "maximum": 256}, "matched_citation_token_count": {"type": "integer", "minimum": 0, "maximum": 256}}},
    "answerable_v03": {"type": "object", "additionalProperties": false, "required": ["classification", "evidence_id", "canonical_entry_id", "claim_id", "citation_id", "claim_text", "citation", "source_ref", "score_components"], "properties": {"classification": {"const": "answerable"}, "evidence_id": {"type": "string", "pattern": "^evidence-[0-9a-f]{32}$"}, "canonical_entry_id": {"$ref": "#/$defs/id"}, "claim_id": {"$ref": "#/$defs/id"}, "citation_id": {"$ref": "#/$defs/id"}, "claim_text": {"type": "string", "minLength": 1, "maxLength": 1024}, "citation": {"type": "string", "minLength": 1, "maxLength": 512}, "source_ref": {"type": "string", "pattern": "^canonical:[a-z0-9][a-z0-9._-]{0,127}#[a-z0-9][a-z0-9._-]{0,127}$", "maxLength": 512}, "score_components": {"$ref": "#/$defs/score"}}},
    "answerable_v04": {"type": "object", "additionalProperties": false, "required": ["classification", "evidence_id", "canonical_entry_id", "claim_id", "citation_id", "claim_text", "citation", "source_ref", "origin_identity", "score_components"], "properties": {"classification": {"const": "answerable"}, "evidence_id": {"type": "string", "pattern": "^evidence-[0-9a-f]{32}$"}, "canonical_entry_id": {"$ref": "#/$defs/id"}, "claim_id": {"$ref": "#/$defs/id"}, "citation_id": {"$ref": "#/$defs/id"}, "claim_text": {"type": "string", "minLength": 1, "maxLength": 1024}, "citation": {"type": "string", "minLength": 1, "maxLength": 512}, "source_ref": {"type": "string", "pattern": "^canonical:[a-z0-9][a-z0-9._-]{0,127}#[a-z0-9][a-z0-9._-]{0,127}$", "maxLength": 512}, "origin_identity": {"$ref": "#/$defs/origin_identity"}, "score_components": {"$ref": "#/$defs/score"}}},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["classification", "canonical_entry_id", "concept_id", "concept_title"], "properties": {"classification": {"const": "metadata_only"}, "canonical_entry_id": {"$ref": "#/$defs/id"}, "concept_id": {"$ref": "#/$defs/id"}, "concept_title": {"type": "string", "minLength": 1, "maxLength": 256}}}
  }
}
