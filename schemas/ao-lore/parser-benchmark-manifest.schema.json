{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/parser-benchmark-manifest.schema.json",
  "title": "AO Lore Parser Benchmark Result Manifest v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "fixture_corpus_digest", "parser_id", "parser_version", "parser_configuration_digest", "runtime", "platform", "document_ir_version", "commands", "raw_metrics", "normalized_scores", "failures", "exclusions", "result_digest"],
  "properties": {
    "schema_version": {"const": "ao.lore.parser-benchmark-manifest.v0.1"},
    "fixture_corpus_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parser_id": {"type": "string"}, "parser_version": {"type": "string"},
    "parser_configuration_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime": {"type": "string"}, "platform": {"type": "string"}, "document_ir_version": {"type": "string"},
    "commands": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "raw_metrics": {"type": "object", "additionalProperties": {"type": ["number", "integer", "null"]}},
    "normalized_scores": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "failures": {"type": "array", "items": {"type": "string"}}, "exclusions": {"type": "array", "items": {"type": "string"}},
    "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
