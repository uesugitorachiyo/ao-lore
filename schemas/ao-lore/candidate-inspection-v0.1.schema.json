{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/candidate-inspection-v0.1.schema.json",
  "title": "AO Lore Candidate Inspection v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "candidate_digest",
    "provenance_digest", "verified_review_events", "review_status",
    "latest_event_digest", "canonical", "promotion_authority"
  ],
  "properties": {
    "schema_version": {"const": "ao.lore.candidate-inspection.v0.1"},
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provenance_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "verified_review_events": {"type": "integer", "minimum": 0},
    "review_status": {"type": "string", "enum": ["unreviewed", "accepted", "rejected"]},
    "latest_event_digest": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "canonical": {"const": false},
    "promotion_authority": {"const": false}
  }
}
