{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/workspace-definition-v0.2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "workspace_version", "workspace_type", "domain", "jurisdiction", "lifecycle_status", "root_workflow_id", "root_workflow_digest", "source_registry_id", "source_registry_digest", "graph_id", "graph_digest", "freshness_policy_id", "freshness_policy_digest", "freshness_summary_status", "freshness_summary_id", "freshness_summary_digest", "reference_workspace_ids", "definition_digest", "document_store_id", "document_generation_digest", "legal_advice", "property_decision", "candidate_review", "candidate_decision", "promotion", "canonical_query", "provider", "credential", "private_data", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.workspace-definition.v0.2"}, "workspace_id": {"$ref": "#/$defs/id"}, "workspace_version": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "workspace_type": {"enum": ["reference", "property", "matter", "operations"]}, "domain": {"$ref": "#/$defs/id"}, "jurisdiction": {"$ref": "#/$defs/id"}, "lifecycle_status": {"enum": ["active", "inactive", "investigate"]}, "root_workflow_id": {"$ref": "#/$defs/id"}, "root_workflow_digest": {"$ref": "#/$defs/digest"}, "source_registry_id": {"$ref": "#/$defs/id"}, "source_registry_digest": {"$ref": "#/$defs/digest"}, "graph_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "graph_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "freshness_policy_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "freshness_policy_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "freshness_summary_status": {"enum": ["observed", "not_observed"]}, "freshness_summary_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "freshness_summary_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}, "reference_workspace_ids": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "definition_digest": {"$ref": "#/$defs/digest"}, "document_store_id": {"$ref": "#/$defs/id"}, "document_generation_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "legal_advice": {"const": false}, "property_decision": {"const": false}, "candidate_review": {"const": false}, "candidate_decision": {"const": false}, "promotion": {"const": false}, "canonical_query": {"const": false}, "provider": {"const": false}, "credential": {"const": false}, "private_data": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  }, "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
