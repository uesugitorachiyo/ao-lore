{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/knowledge-evidence-projection-v0.1.schema.json",
  "title": "AO Lore Knowledge Evidence Projection v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "requirement_ids", "supported_claims", "source_ref", "source_digest", "citation", "provenance", "freshness_met", "trust_met", "verified"],
  "properties": {
    "schema_version": {"const": "ao.lore.knowledge-evidence-projection.v0.1"}, "evidence_id": {"type": "string", "pattern": "^evidence-[0-9a-f]{32}$"},
    "requirement_ids": {"type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "supported_claims": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/supported_claim"}},
    "source_ref": {"type": "string", "pattern": "^canonical:[a-z0-9][a-z0-9._-]{0,127}#[a-z0-9][a-z0-9._-]{0,127}$", "maxLength": 512},
    "source_digest": {"$ref": "#/$defs/digest"}, "citation": {"type": "string", "minLength": 1, "maxLength": 512},
    "provenance": {"$ref": "#/$defs/provenance"}, "freshness_met": {"type": "boolean"}, "trust_met": {"type": "boolean"}, "verified": {"const": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "supported_claim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "text"], "properties": {"claim_id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1, "maxLength": 1024}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["generation_id", "generation_manifest_digest", "canonical_entry_id", "canonical_entry_digest", "candidate_id", "provenance_digest", "parser_id", "parser_version", "entry_schema_version"], "properties": {"generation_id": {"$ref": "#/$defs/id"}, "generation_manifest_digest": {"$ref": "#/$defs/digest"}, "canonical_entry_id": {"$ref": "#/$defs/id"}, "canonical_entry_digest": {"$ref": "#/$defs/digest"}, "candidate_id": {"$ref": "#/$defs/id"}, "provenance_digest": {"$ref": "#/$defs/digest"}, "parser_id": {"$ref": "#/$defs/id"}, "parser_version": {"type": "string", "minLength": 1, "maxLength": 128}, "entry_schema_version": {"const": "ao.lore.okf-canonical-entry.v0.3"}}}
  }
}
