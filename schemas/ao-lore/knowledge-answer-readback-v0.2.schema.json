{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/knowledge-answer-readback-v0.2.schema.json", "title": "AO Lore Knowledge Answer Readback v0.2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "snapshot_digest", "coverage_report_digest", "claim_ids", "evidence_ids", "citations", "legacy_v0_2_entry_count", "answerable_v0_4_entry_count", "answer", "reason_code"],
  "properties": {"schema_version": {"const": "ao.lore.knowledge-answer-readback.v0.2"}, "status": {"enum": ["answer", "partial", "refuse", "investigate"]}, "snapshot_digest": {"$ref": "#/$defs/digest"}, "coverage_report_digest": {"$ref": "#/$defs/digest"}, "claim_ids": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "evidence_ids": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence-[0-9a-f]{32}$"}}, "citations": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"oneOf": [{"type": "string", "pattern": "^canonical:[a-z0-9][a-z0-9._-]{0,127}#[a-z0-9][a-z0-9._-]{0,127}$", "maxLength": 512}, {"$ref": "#/$defs/origin_citation"}]}}, "legacy_v0_2_entry_count": {"type": "integer", "minimum": 0, "maximum": 10000}, "answerable_v0_4_entry_count": {"type": "integer", "minimum": 1, "maximum": 10000}, "answer": {"type": "string", "maxLength": 32768}, "reason_code": {"enum": ["none", "no_answerable_entries", "legacy_metadata_only", "coverage_insufficient", "hard_contradiction", "freshness_gate_failed", "trust_gate_failed", "canonical_state_invalid", "unsupported_active_version", "snapshot_drift"]}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "origin_identity": {"type": "object", "additionalProperties": false, "required": ["workspace_id", "evidence_kind", "evidence_id", "evidence_digest"], "properties": {"workspace_id": {"$ref": "#/$defs/id"}, "evidence_kind": {"enum": ["document_block", "graph_claim", "graph_edge"]}, "evidence_id": {"type": "string", "pattern": "^(?:sha256:[0-9a-f]{64}|[a-z0-9][a-z0-9._-]{0,127})$"}, "evidence_digest": {"$ref": "#/$defs/digest"}}}, "origin_citation": {"type": "object", "additionalProperties": false, "required": ["source_ref", "origin_identity"], "properties": {"source_ref": {"type": "string", "pattern": "^canonical:[a-z0-9][a-z0-9._-]{0,127}#[a-z0-9][a-z0-9._-]{0,127}$", "maxLength": 512}, "origin_identity": {"$ref": "#/$defs/origin_identity"}}}}
}
