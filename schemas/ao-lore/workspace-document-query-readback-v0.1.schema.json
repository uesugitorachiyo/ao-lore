{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/workspace-document-query-readback-v0.1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "query_id", "prompt_digest", "workspace_id", "generation_digest", "outcome", "reason_code", "evidence", "qualifications", "readback_digest", "legal_advice", "property_decision", "candidate_review", "candidate_decision", "promotion", "canonical_query", "provider", "credential", "private_data", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.workspace-document-query-readback.v0.1"}, "query_id": {"$ref": "#/$defs/id"}, "prompt_digest": {"$ref": "#/$defs/digest"}, "workspace_id": {"$ref": "#/$defs/id"}, "generation_digest": {"$ref": "#/$defs/digest"}, "outcome": {"enum": ["answer", "partial", "refuse", "investigate"]}, "reason_code": {"$ref": "#/$defs/id"}, "evidence": {"type": "array", "minItems": 0, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}, "qualifications": {"type": "array", "minItems": 0, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/public_text"}}, "readback_digest": {"$ref": "#/$defs/digest"},
    "legal_advice": {"const": false}, "property_decision": {"const": false}, "candidate_review": {"const": false}, "candidate_decision": {"const": false}, "promotion": {"const": false}, "canonical_query": {"const": false}, "provider": {"const": false}, "credential": {"const": false}, "private_data": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "document_id": {"type": "string", "pattern": "^(?:sha256:[0-9a-f]{64}|[a-z0-9][a-z0-9._-]{0,127})$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "public_text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!.*[\\u0000-\\u001f])(?!/|[Ff][Ii][Ll][Ee]:)(?!.*(?:/[Hh][Oo][Mm][Ee]/|/[Oo][Pp][Tt]/|/[Tt][Mm][Pp]/|\\\\)).+$"},
    "span": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"page": {"type": "integer", "minimum": 1}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}, "coordinates": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "workspace_id", "generation_digest", "document_id", "document_ir_digest", "source_id", "source_digest", "block_id", "block_digest", "render_text", "source_span", "authority_role", "sensitivity", "freshness_status", "qualification_codes"], "properties": {"evidence_id": {"$ref": "#/$defs/digest"}, "workspace_id": {"$ref": "#/$defs/id"}, "generation_digest": {"$ref": "#/$defs/digest"}, "document_id": {"$ref": "#/$defs/document_id"}, "document_ir_digest": {"$ref": "#/$defs/digest"}, "source_id": {"$ref": "#/$defs/id"}, "source_digest": {"$ref": "#/$defs/digest"}, "block_id": {"type": "string", "minLength": 1, "maxLength": 256}, "block_digest": {"$ref": "#/$defs/digest"}, "render_text": {"type": "string", "maxLength": 1048576}, "source_span": {"$ref": "#/$defs/span"}, "authority_role": {"enum": ["primary_law", "official_interpretation", "local_enforcement_guidance", "technical_guidance", "operator_procedure", "case_evidence"]}, "sensitivity": {"enum": ["public", "internal", "restricted"]}, "freshness_status": {"enum": ["current", "stale", "superseded", "unavailable", "unknown"]}, "qualification_codes": {"type": "array", "minItems": 0, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}
  }
}
