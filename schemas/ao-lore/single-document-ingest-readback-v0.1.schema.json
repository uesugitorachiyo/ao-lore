{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/single-document-ingest-readback-v0.1.schema.json",
  "title": "AO Lore Single Document Ingest Readback v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "candidate_id", "candidate_digest",
    "provenance_digest", "source_digest", "parser_id", "parser_version",
    "document_ir_digest", "parser_selection_report_digest",
    "parse_quality_report_digest", "distillation_trace_digest",
    "review_status", "next_commands", "canonical", "promotion_authority"
  ],
  "properties": {
    "schema_version": {"const": "ao.lore.single-document-ingest-readback.v0.1"},
    "status": {"type": "string", "enum": ["created", "unchanged"]},
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provenance_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parser_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "parser_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "document_ir_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parser_selection_report_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parse_quality_report_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "distillation_trace_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review_status": {"type": "string", "enum": ["unreviewed", "accepted", "rejected"]},
    "next_commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    },
    "canonical": {"const": false},
    "promotion_authority": {"const": false}
  }
}
