{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/candidate-quality-question-results-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_results_id",
    "campaign_id",
    "questions_digest",
    "result_count",
    "results",
    "question_results_digest",
    "canonical_query_invoked",
    "review_event_appended",
    "candidate_decision_taken",
    "promotion_prepared",
    "promotion_applied",
    "provider_calls",
    "network_accessed",
    "credential_used",
    "publication",
    "release",
    "deployment",
    "authority_advanced"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.lore.candidate-quality-question-results.v0.1"
    },
    "question_results_id": {
      "$ref": "#/$defs/identifier"
    },
    "campaign_id": {
      "$ref": "#/$defs/identifier"
    },
    "questions_digest": {
      "$ref": "#/$defs/digest"
    },
    "result_count": {
      "type": "integer",
      "const": 24
    },
    "results": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "candidate_id",
          "expected_outcome",
          "actual_outcome",
          "supporting_claim_ids",
          "supporting_claim_count",
          "evidence_match_millionths"
        ],
        "properties": {
          "question_id": {
            "$ref": "#/$defs/identifier"
          },
          "candidate_id": {
            "$ref": "#/$defs/identifier"
          },
          "expected_outcome": {
            "enum": [
              "supported",
              "refusal"
            ]
          },
          "actual_outcome": {
            "enum": [
              "supported",
              "refusal"
            ]
          },
          "supporting_claim_ids": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "supporting_claim_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "evidence_match_millionths": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        }
      }
    },
    "question_results_digest": {
      "$ref": "#/$defs/digest"
    },
    "canonical_query_invoked": {
      "const": false
    },
    "review_event_appended": {
      "const": false
    },
    "candidate_decision_taken": {
      "const": false
    },
    "promotion_prepared": {
      "const": false
    },
    "promotion_applied": {
      "const": false
    },
    "provider_calls": {
      "const": false
    },
    "network_accessed": {
      "const": false
    },
    "credential_used": {
      "const": false
    },
    "publication": {
      "const": false
    },
    "release": {
      "const": false
    },
    "deployment": {
      "const": false
    },
    "authority_advanced": {
      "const": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
