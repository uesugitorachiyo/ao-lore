{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/evidence-freshness-comparison-v0.1.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "comparison_id", "policy_id", "bundle_id", "graph_id", "graph_digest", "source_id", "prior_record_digest", "observation_id", "observation_digest", "classification", "reason_codes", "prior_content_digest", "observed_content_digest", "prior_locator", "observed_locator", "prior_media_type", "observed_media_type", "observed_version", "observed_effective_date", "declared_successor_locator", "qualification", "comparison_digest", "legal_advice", "property_decision", "candidate_review", "candidate_decision", "promotion", "canonical_query", "provider", "credential", "private_data", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.evidence-freshness-comparison.v0.1"}, "comparison_id": {"$ref": "#/$defs/id"}, "policy_id": {"$ref": "#/$defs/id"}, "bundle_id": {"$ref": "#/$defs/id"}, "graph_id": {"$ref": "#/$defs/id"}, "graph_digest": {"$ref": "#/$defs/digest"}, "source_id": {"$ref": "#/$defs/id"}, "prior_record_digest": {"$ref": "#/$defs/digest"}, "observation_id": {"$ref": "#/$defs/id"}, "observation_digest": {"$ref": "#/$defs/digest"},
    "classification": {"enum": ["unchanged", "updated", "superseded", "unavailable", "investigate"]}, "reason_codes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/reason_code"}}, "prior_content_digest": {"$ref": "#/$defs/digest"}, "observed_content_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "prior_locator": {"$ref": "#/$defs/locator"}, "observed_locator": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locator"}]}, "prior_media_type": {"$ref": "#/$defs/media_type"}, "observed_media_type": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/media_type"}]}, "observed_version": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/public_text_128"}]}, "observed_effective_date": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]}, "declared_successor_locator": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locator"}]}, "qualification": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/public_text_512"}]},
    "comparison_digest": {"$ref": "#/$defs/digest"}, "legal_advice": {"const": false}, "property_decision": {"const": false}, "candidate_review": {"const": false}, "candidate_decision": {"const": false}, "promotion": {"const": false}, "canonical_query": {"const": false}, "provider": {"const": false}, "credential": {"const": false}, "private_data": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  },
  "allOf": [{"if": {"properties": {"classification": {"const": "superseded"}}}, "then": {"properties": {"observed_version": {"$ref": "#/$defs/public_text_128"}, "observed_effective_date": {"$ref": "#/$defs/date"}, "reason_codes": {"not": {"contains": {"enum": ["version_ambiguous", "effective_date_ambiguous"]}}}}}}],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "date": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"}, "reason_code": {"enum": ["content_unchanged", "content_changed", "declared_successor_verified", "terminal_unavailable", "redirect_drift", "media_type_drift", "locator_drift", "version_ambiguous", "effective_date_ambiguous", "prior_binding_drift", "unsafe_observation"]}, "media_type": {"type": "string", "maxLength": 192, "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,127}$"}, "public_text_128": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*[\\u0000-\\u001f])(?!/)(?!file:)(?!.*(?:/home/|/opt/|\\\\)).+$"}, "public_text_512": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!.*[\\u0000-\\u001f])(?!/)(?!file:)(?!.*(?:/home/|/opt/|\\\\)).+$"}, "locator": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?!.*[\\u0000-\\u001f\\u007f-\\u009f])(?!.*\\s$)https:\\/\\/(?!(?:(?:0x[0-9a-f]+|[0-9]+)\\.)*(?:0x[0-9a-f]+|[0-9]+)(?::443)?/)(?=[^/:?#]{1,253}(?::443)?/)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::443)?/(?=[^?#]{0,1023}(?:\\?|$))[^#]*$"}}
}
