{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.ao-lore.example/public-release-readiness-v0.1.schema.json","type":"object","additionalProperties":false,"required":["schema_version","status","source_head","clean_commit","policy_digest","manifest_digest","file_count","total_bytes","gates","authority"],"properties":{"schema_version":{"const":"ao.lore.public-release-readiness.v0.1"},"status":{"enum":["ready","rejected"]},"source_head":{"type":"string","pattern":"^[0-9a-f]{40}$"},"clean_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"policy_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"manifest_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"file_count":{"type":"integer","minimum":0},"total_bytes":{"type":"integer","minimum":0},"gates":{"type":"object","additionalProperties":false,"required":["contracts","safety","clean_checkout","git_fsck"],"properties":{"contracts":{"enum":["pass","fail"]},"safety":{"enum":["pass","fail"]},"clean_checkout":{"enum":["pass","fail"]},"git_fsck":{"enum":["pass","fail"]}}},"authority":{"type":"object","additionalProperties":false,"required":["github_created","github_push","network_used","release","deployment"],"properties":{"github_created":{"const":false},"github_push":{"const":false},"network_used":{"const":false},"release":{"const":false},"deployment":{"const":false}}}}}
