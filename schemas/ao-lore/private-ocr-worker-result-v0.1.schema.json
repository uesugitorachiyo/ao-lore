{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/private-ocr-worker-result-v0.1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "policy_digest", "run_id", "candidate_id", "runtime_digest", "model_set_digest", "configuration_digest", "latency_microseconds", "peak_gpu_memory_bytes", "pages", "network_accessed", "provider_calls", "promotion", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.private-ocr-worker-result.v0.1"},
    "policy_digest": {"const": "sha256:fe17335189fcf75471d0adb3251e14a34c7e16cb66071e90361e50d77b6c7e20"},
    "run_id": {"$ref": "#/$defs/id"}, "candidate_id": {"enum": ["candidate-1", "candidate-2", "candidate-3"]},
    "runtime_digest": {"$ref": "#/$defs/digest"}, "model_set_digest": {"$ref": "#/$defs/digest"},
    "configuration_digest": {"$ref": "#/$defs/digest"},
    "latency_microseconds": {"type": "integer", "minimum": 0, "maximum": 240000000},
    "peak_gpu_memory_bytes": {"type": "integer", "minimum": 0, "maximum": 34359738368},
    "pages": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/page"}},
    "network_accessed": {"const": false}, "provider_calls": {"const": false},
    "promotion": {"const": false}, "publication": {"const": false}, "release": {"const": false},
    "deployment": {"const": false}, "authority_advanced": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 25000000}},
    "detection": {"type": "object", "additionalProperties": false, "required": ["index", "text", "confidence_millionths", "polygon"], "properties": {
      "index": {"type": "integer", "minimum": 0, "maximum": 99999},
      "text": {"type": "string", "minLength": 1, "maxLength": 4096},
      "confidence_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000},
      "polygon": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/point"}}
    }},
    "page": {"type": "object", "additionalProperties": false, "required": ["page_id", "width", "height", "detections"], "properties": {
      "page_id": {"$ref": "#/$defs/id"}, "width": {"type": "integer", "minimum": 1, "maximum": 25000000},
      "height": {"type": "integer", "minimum": 1, "maximum": 25000000},
      "detections": {"type": "array", "minItems": 0, "maxItems": 100000, "items": {"$ref": "#/$defs/detection"}}
    }}
  }
}
