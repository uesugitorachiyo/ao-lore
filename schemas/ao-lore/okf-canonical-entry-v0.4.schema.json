{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/okf-canonical-entry-v0.4.schema.json",
  "title": "AO Lore Canonical OKF Entry v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "canonical_entry_id", "semantic_key", "candidate_id", "candidate_digest", "evidence_selection_digest", "evidence_origins", "provenance_digest", "accepted_review_head_digest", "concepts", "claim_mappings", "links", "claims_schema_version", "claims_digest", "claims", "citations_schema_version", "citations_digest", "citations", "knowledge_policy"],
  "properties": {
    "schema_version": {"const": "ao.lore.okf-canonical-entry.v0.4"},
    "policy_version": {"const": "ao.lore.promotion-policy.v0.1"},
    "canonical_entry_id": {"$ref": "#/$defs/id"},
    "semantic_key": {"$ref": "#/$defs/digest"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_digest": {"$ref": "#/$defs/digest"},
    "evidence_selection_digest": {"$ref": "#/$defs/digest"},
    "evidence_origins": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "okf-candidate-v0.3.schema.json#/$defs/evidence"}},
    "provenance_digest": {"$ref": "#/$defs/digest"},
    "accepted_review_head_digest": {"$ref": "#/$defs/digest"},
    "concepts": {"type": "array", "maxItems": 10000, "items": {"$ref": "okf-canonical-entry-v0.3.schema.json#/$defs/concept"}},
    "claim_mappings": {"type": "array", "maxItems": 10000, "items": {"$ref": "okf-canonical-entry-v0.3.schema.json#/$defs/claim_mapping"}},
    "links": {"type": "array", "maxItems": 10000, "items": {"$ref": "okf-canonical-entry-v0.3.schema.json#/$defs/link"}},
    "claims_schema_version": {"const": "ao.lore.canonical-claim-set.v0.1"},
    "claims_digest": {"$ref": "#/$defs/digest"},
    "claims": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/claim"}},
    "citations_schema_version": {"const": "ao.lore.canonical-citation-set.v0.1"},
    "citations_digest": {"$ref": "#/$defs/digest"},
    "citations": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/citation"}},
    "knowledge_policy": {"$ref": "okf-canonical-entry-v0.3.schema.json#/$defs/knowledge_policy"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "text", "source_block_ids", "citation_id"], "properties": {"claim_id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1, "maxLength": 1024}, "source_block_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "citation_id": {"$ref": "#/$defs/id"}}},
    "citation": {"type": "object", "additionalProperties": false, "required": ["citation_id", "render_text", "source_block_ids"], "properties": {"citation_id": {"$ref": "#/$defs/id"}, "render_text": {"type": "string", "minLength": 1, "maxLength": 512}, "source_block_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}
  }
}
