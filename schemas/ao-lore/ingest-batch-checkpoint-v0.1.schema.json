{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/ingest-batch-checkpoint-v0.1.schema.json",
  "title": "AO Lore Ingest Batch Checkpoint v0.1",
  "$comment": "Runtime validation MUST enforce manifest_items/items identity and order correspondence plus count/index arithmetic; JSON Schema constrains only shape and bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "manifest_digest", "manifest_items", "items",
    "created", "unchanged", "rejected", "processed", "next_item_index",
    "previous_checkpoint_digest", "checkpoint_digest", "canonical", "promotion_authority"
  ],
  "properties": {
    "schema_version": {"const": "ao.lore.ingest-batch-checkpoint.v0.1"},
    "batch_id": {"$ref": "#/$defs/batch_id"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "manifest_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/manifest_item"}
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/success_item"},
          {"$ref": "#/$defs/rejected_item"}
        ]
      }
    },
    "created": {"type": "integer", "minimum": 0, "maximum": 100},
    "unchanged": {"type": "integer", "minimum": 0, "maximum": 100},
    "rejected": {"type": "integer", "minimum": 0, "maximum": 100},
    "processed": {"type": "integer", "minimum": 0, "maximum": 100},
    "next_item_index": {"type": "integer", "minimum": 0, "maximum": 100},
    "previous_checkpoint_digest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/digest"}
      ]
    },
    "checkpoint_digest": {"$ref": "#/$defs/digest"},
    "canonical": {"const": false},
    "promotion_authority": {"const": false}
  },
  "$defs": {
    "batch_id": {
      "type": "string",
      "pattern": "^batch-[a-z0-9][a-z0-9-]{0,62}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "item_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^candidate-[a-z0-9][a-z0-9._-]{0,117}$"
    },
    "manifest_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "source_digest"],
      "properties": {
        "item_id": {"$ref": "#/$defs/item_id"},
        "source_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "success_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id", "source_digest", "status", "candidate_id",
        "candidate_digest", "provenance_digest", "review_status"
      ],
      "properties": {
        "item_id": {"$ref": "#/$defs/item_id"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "status": {"type": "string", "enum": ["created", "unchanged"]},
        "candidate_id": {"$ref": "#/$defs/candidate_id"},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "provenance_digest": {"$ref": "#/$defs/digest"},
        "review_status": {
          "type": "string",
          "enum": ["unreviewed", "accepted", "rejected"]
        }
      }
    },
    "rejected_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "source_digest", "status", "error_code"],
      "properties": {
        "item_id": {"$ref": "#/$defs/item_id"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "status": {"const": "rejected"},
        "error_code": {
          "type": "string",
          "enum": [
            "source_invalid", "source_digest_mismatch", "qualification_invalid",
            "parser_rejected", "distillation_rejected", "candidate_conflict",
            "document_rejected"
          ]
        }
      }
    }
  }
}
