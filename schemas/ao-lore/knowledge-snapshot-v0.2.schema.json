{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/knowledge-snapshot-v0.2.schema.json",
  "title": "AO Lore Knowledge Snapshot v0.2",
  "type": "object", "additionalProperties": false,
  "required": ["snapshot_schema_version", "latest_generation_id", "latest_generation_manifest_digest", "snapshot_digest", "effective_entries", "legacy_v0_2_entry_count", "answerable_v0_3_entry_count", "answerable_v0_4_entry_count"],
  "properties": {
    "snapshot_schema_version": {"const": "ao.lore.knowledge-snapshot.v0.2"},
    "latest_generation_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "latest_generation_manifest_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "snapshot_digest": {"$ref": "#/$defs/digest"},
    "effective_entries": {"type": "array", "maxItems": 10000, "items": {"oneOf": [{"$ref": "#/$defs/metadata_entry"}, {"$ref": "#/$defs/v0_3_entry"}, {"$ref": "#/$defs/origin_entry"}]}},
    "legacy_v0_2_entry_count": {"$ref": "#/$defs/count"},
    "answerable_v0_3_entry_count": {"$ref": "#/$defs/count"},
    "answerable_v0_4_entry_count": {"type": "integer", "minimum": 1, "maximum": 10000}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "origin_identity": {"type": "object", "additionalProperties": false, "required": ["workspace_id", "evidence_kind", "evidence_id", "evidence_digest"], "properties": {"workspace_id": {"$ref": "#/$defs/id"}, "evidence_kind": {"enum": ["document_block", "graph_claim", "graph_edge"]}, "evidence_id": {"type": "string", "pattern": "^(?:sha256:[0-9a-f]{64}|[a-z0-9][a-z0-9._-]{0,127})$"}, "evidence_digest": {"$ref": "#/$defs/digest"}}},
    "metadata_entry": {"type": "object", "additionalProperties": false, "required": ["canonical_entry_id", "canonical_entry_digest", "entry_schema_version", "answerability", "claim_count"], "properties": {"canonical_entry_id": {"$ref": "#/$defs/id"}, "canonical_entry_digest": {"$ref": "#/$defs/digest"}, "entry_schema_version": {"const": "ao.lore.okf-canonical-entry.v0.2"}, "answerability": {"const": "metadata_only"}, "claim_count": {"$ref": "#/$defs/count"}}},
    "v0_3_entry": {"type": "object", "additionalProperties": false, "required": ["canonical_entry_id", "canonical_entry_digest", "entry_schema_version", "answerability", "claim_count"], "properties": {"canonical_entry_id": {"$ref": "#/$defs/id"}, "canonical_entry_digest": {"$ref": "#/$defs/digest"}, "entry_schema_version": {"const": "ao.lore.okf-canonical-entry.v0.3"}, "answerability": {"const": "answerable"}, "claim_count": {"$ref": "#/$defs/count"}}},
    "origin_entry": {"type": "object", "additionalProperties": false, "required": ["canonical_entry_id", "canonical_entry_digest", "entry_schema_version", "answerability", "claim_count", "evidence_origin_identities"], "properties": {"canonical_entry_id": {"$ref": "#/$defs/id"}, "canonical_entry_digest": {"$ref": "#/$defs/digest"}, "entry_schema_version": {"const": "ao.lore.okf-canonical-entry.v0.4"}, "answerability": {"const": "answerable"}, "claim_count": {"$ref": "#/$defs/count"}, "evidence_origin_identities": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/origin_identity"}}}}
  }
}
