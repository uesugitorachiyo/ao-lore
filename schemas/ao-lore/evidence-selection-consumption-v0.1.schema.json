{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/evidence-selection-consumption-v0.1.schema.json",
  "title": "AO Lore Evidence Selection Consumption v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "consumption_id",
    "proposal_id",
    "proposal_digest",
    "authorization_id",
    "authorization_digest",
    "candidate_id",
    "nonce",
    "consumed_at",
    "status",
    "consumption_digest",
    "candidate_creation",
    "legal_advice",
    "property_decision",
    "candidate_review",
    "candidate_decision",
    "promotion",
    "canonical_query",
    "provider",
    "credential",
    "private_data",
    "publication",
    "release",
    "deployment",
    "authority_advanced"
  ],
  "properties": {
    "schema_version": {"const": "ao.lore.evidence-selection-consumption.v0.1"},
    "consumption_id": {"$ref": "#/$defs/id"},
    "proposal_id": {"$ref": "#/$defs/id"},
    "proposal_digest": {"$ref": "#/$defs/digest"},
    "authorization_id": {"$ref": "#/$defs/id"},
    "authorization_digest": {"$ref": "#/$defs/digest"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "nonce": {"$ref": "#/$defs/id"},
    "consumed_at": {"$ref": "#/$defs/time"},
    "status": {"const": "consumed"},
    "consumption_digest": {"$ref": "#/$defs/digest"},
    "candidate_creation": {"const": false},
    "legal_advice": {"const": false},
    "property_decision": {"const": false},
    "candidate_review": {"const": false},
    "candidate_decision": {"const": false},
    "promotion": {"const": false},
    "canonical_query": {"const": false},
    "provider": {"const": false},
    "credential": {"const": false},
    "private_data": {"const": false},
    "publication": {"const": false},
    "release": {"const": false},
    "deployment": {"const": false},
    "authority_advanced": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "time": {"type": "string", "format": "date-time", "maxLength": 32}
  }
}
