{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/monitoring-observation-v0.1.schema.json",
  "title": "AO Lore Monitoring Observation v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "observation_id",
    "target_id",
    "baseline_id",
    "baseline_sha256",
    "source_head_sha256",
    "profile_sha256",
    "observed_at_utc",
    "metrics",
    "role_fallbacks",
    "trace_policy_sha256",
    "trace_integrity"
  ],
  "properties": {
    "schema_version": { "const": "ao.lore.monitoring-observation.v0.1" },
    "observation_id": { "$ref": "#/$defs/id" },
    "target_id": { "$ref": "#/$defs/id" },
    "baseline_id": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/id" }] },
    "baseline_sha256": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/sha256" }] },
    "source_head_sha256": { "$ref": "#/$defs/sha256" },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "observed_at_utc": { "type": "string", "format": "date-time" },
    "metrics": { "$ref": "#/$defs/metrics" },
    "role_fallbacks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["role", "from_adapter", "to_adapter"],
        "properties": {
          "role": { "enum": ["parser", "distiller", "navigator", "synthesizer"] },
          "from_adapter": { "$ref": "#/$defs/id" },
          "to_adapter": { "$ref": "#/$defs/id" }
        },
        "additionalProperties": false
      }
    },
    "trace_policy_sha256": { "$ref": "#/$defs/sha256" },
    "trace_integrity": { "type": "boolean" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "basisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "boundedNonnegative": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "metrics": {
      "type": "object",
      "required": [
        "parser_selection_score_basis_points",
        "parse_quality_threshold_basis_points",
        "evidence_coverage_basis_points",
        "wasted_traversal_nodes",
        "nodes_per_satisfied_requirement_milli",
        "tokens_per_coverage_point_milli"
      ],
      "properties": {
        "parser_selection_score_basis_points": { "$ref": "#/$defs/basisPoints" },
        "parse_quality_threshold_basis_points": { "$ref": "#/$defs/basisPoints" },
        "evidence_coverage_basis_points": { "$ref": "#/$defs/basisPoints" },
        "wasted_traversal_nodes": { "$ref": "#/$defs/boundedNonnegative" },
        "nodes_per_satisfied_requirement_milli": { "$ref": "#/$defs/boundedNonnegative" },
        "tokens_per_coverage_point_milli": { "$ref": "#/$defs/boundedNonnegative" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
