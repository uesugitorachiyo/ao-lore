{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/evidence-graph-inspection-v0.1.schema.json", "$comment": "Shape only. Product consumers must bind graph identity, exact manifest counts, and independently computed orphan counts with the context-aware runtime validator.", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "graph_id", "graph_digest", "result", "source_count", "claim_count", "edge_count", "question_count", "orphan_source_count", "orphan_claim_count", "conflict_count", "stale_source_count", "inspection_digest", "legal_advice", "property_decision", "candidate_review", "candidate_decision", "promotion", "canonical_query", "provider", "credential", "private_data", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.evidence-graph-inspection.v0.1"}, "graph_id": {"$ref": "#/$defs/id"}, "graph_digest": {"$ref": "#/$defs/digest"}, "result": {"enum": ["pass", "investigate", "refuse"]},
    "source_count": {"type": "integer", "minimum": 0, "maximum": 16}, "claim_count": {"type": "integer", "minimum": 0, "maximum": 512}, "edge_count": {"type": "integer", "minimum": 0, "maximum": 2048}, "question_count": {"type": "integer", "minimum": 0, "maximum": 32},
    "orphan_source_count": {"type": "integer", "minimum": 0, "maximum": 16}, "orphan_claim_count": {"type": "integer", "minimum": 0, "maximum": 512}, "conflict_count": {"type": "integer", "minimum": 0, "maximum": 2048}, "stale_source_count": {"type": "integer", "minimum": 0, "maximum": 16}, "inspection_digest": {"$ref": "#/$defs/digest"},
    "legal_advice": {"const": false}, "property_decision": {"const": false}, "candidate_review": {"const": false}, "candidate_decision": {"const": false}, "promotion": {"const": false}, "canonical_query": {"const": false}, "provider": {"const": false}, "credential": {"const": false}, "private_data": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  }, "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
