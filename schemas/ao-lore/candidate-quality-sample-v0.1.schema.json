{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/candidate-quality-sample-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "campaign_id",
    "policy_digest",
    "total_selected_claims",
    "selections",
    "sample_digest",
    "canonical_query_invoked",
    "review_event_appended",
    "candidate_decision_taken",
    "promotion_prepared",
    "promotion_applied",
    "provider_calls",
    "network_accessed",
    "credential_used",
    "publication",
    "release",
    "deployment",
    "authority_advanced"
  ],
  "properties": {
    "schema_version": {
      "const": "ao.lore.candidate-quality-sample.v0.1"
    },
    "sample_id": {
      "$ref": "#/$defs/identifier"
    },
    "campaign_id": {
      "$ref": "#/$defs/identifier"
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "total_selected_claims": {
      "type": "integer",
      "const": 96
    },
    "selections": {
      "type": "array",
      "minItems": 96,
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_ordinal",
          "candidate_id",
          "claim_id",
          "citation_id",
          "claim_record_digest",
          "candidate_digest",
          "provenance_digest",
          "source_digest",
          "reason_codes"
        ],
        "properties": {
          "sample_ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 96
          },
          "candidate_id": {
            "$ref": "#/$defs/identifier"
          },
          "claim_id": {
            "$ref": "#/$defs/identifier"
          },
          "citation_id": {
            "$ref": "#/$defs/identifier"
          },
          "claim_record_digest": {
            "$ref": "#/$defs/digest"
          },
          "candidate_digest": {
            "$ref": "#/$defs/digest"
          },
          "provenance_digest": {
            "$ref": "#/$defs/digest"
          },
          "source_digest": {
            "$ref": "#/$defs/digest"
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "enum": [
                "binding_risk",
                "normalized_duplicate",
                "fragmentation",
                "first_position",
                "middle_position",
                "final_position",
                "longest_claim",
                "shortest_claim",
                "block_type_representative",
                "digest_fill"
              ]
            }
          }
        }
      }
    },
    "sample_digest": {
      "$ref": "#/$defs/digest"
    },
    "canonical_query_invoked": {
      "const": false
    },
    "review_event_appended": {
      "const": false
    },
    "candidate_decision_taken": {
      "const": false
    },
    "promotion_prepared": {
      "const": false
    },
    "promotion_applied": {
      "const": false
    },
    "provider_calls": {
      "const": false
    },
    "network_accessed": {
      "const": false
    },
    "credential_used": {
      "const": false
    },
    "publication": {
      "const": false
    },
    "release": {
      "const": false
    },
    "deployment": {
      "const": false
    },
    "authority_advanced": {
      "const": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
