{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/parse-quality-profile.schema.json",
  "title": "AO Lore Parse Quality Profile v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "profile_id", "version", "media_type", "workload", "component_weights", "accept_threshold", "fallback_threshold", "maximum_fallbacks", "critical_failures", "calibration_result_digest"],
  "properties": {
    "schema_version": {"const": "ao.lore.parse-quality-profile.v0.1"},
    "profile_id": {"type": "string"}, "version": {"type": "string"}, "media_type": {"type": "string"}, "workload": {"type": "string"},
    "component_weights": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}},
    "accept_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "fallback_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "maximum_fallbacks": {"type": "integer", "minimum": 0},
    "critical_failures": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "calibration_result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
