{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-lore.example/canonical-citation-set-v0.1.schema.json",
  "title": "AO Lore Canonical Citation Set v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "citations"],
  "properties": {
    "schema_version": {"const": "ao.lore.canonical-citation-set.v0.1"},
    "citations": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/citation"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "id_list": {"type": "array", "minItems": 1, "maxItems": 5000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["citation_id", "render_text", "source_block_ids"],
      "properties": {
        "citation_id": {"$ref": "#/$defs/id"},
        "render_text": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_block_ids": {"$ref": "#/$defs/id_list"}
      }
    }
  }
}
