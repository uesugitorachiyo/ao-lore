{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/workspace-operation-readback-v0.1.schema.json", "$comment": "Shape only; bind to a validated registry generation and selected workspace set with the runtime validator.", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "operation_id", "operation", "workspace_id", "registry_id", "registry_digest", "status", "reason_code", "affected_workspace_ids", "readback_digest", "legal_advice", "property_decision", "candidate_review", "candidate_decision", "promotion", "canonical_query", "provider", "credential", "private_data", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.workspace-operation-readback.v0.1"}, "operation_id": {"$ref": "#/$defs/id"}, "operation": {"enum": ["list", "inspect", "refresh", "replay", "recover"]}, "workspace_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "registry_id": {"$ref": "#/$defs/id"}, "registry_digest": {"$ref": "#/$defs/digest"}, "status": {"enum": ["active", "empty", "complete", "success", "inactive", "investigate"]}, "reason_code": {"$ref": "#/$defs/reason_code"}, "affected_workspace_ids": {"type": "array", "minItems": 0, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "readback_digest": {"$ref": "#/$defs/digest"},
    "legal_advice": {"const": false}, "property_decision": {"const": false}, "candidate_review": {"const": false}, "candidate_decision": {"const": false}, "promotion": {"const": false}, "canonical_query": {"const": false}, "provider": {"const": false}, "credential": {"const": false}, "private_data": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  },
  "allOf": [{"if": {"properties": {"status": {"enum": ["active", "empty", "complete", "success"]}}, "required": ["status"]}, "then": {"properties": {"reason_code": {"const": "ok"}}}, "else": {"properties": {"reason_code": {"not": {"const": "ok"}}}}}],
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "reason_code": {"enum": ["ok", "workspace_unknown", "workspace_inactive", "registry_invalid", "identity_collision", "reference_not_declared", "reference_cycle", "workspace_binding_drift", "freshness_investigation_required", "recovery_pending"]}}
}
