{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.ao-lore.example/workspace-query-readback-v0.1.schema.json", "$comment": "Shape only; bind origins to a validated registry generation and exact selected workspace set with the runtime validator.", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "query_id", "prompt_digest", "registry_id", "registry_digest", "primary_workspace_id", "consulted_workspace_ids", "outcome", "reason_code", "evidence", "qualifications", "readback_digest", "legal_advice", "property_decision", "candidate_review", "candidate_decision", "promotion", "canonical_query", "provider", "credential", "private_data", "publication", "release", "deployment", "authority_advanced"],
  "properties": {
    "schema_version": {"const": "ao.lore.workspace-query-readback.v0.1"}, "query_id": {"$ref": "#/$defs/id"}, "prompt_digest": {"$ref": "#/$defs/digest"}, "registry_id": {"$ref": "#/$defs/id"}, "registry_digest": {"$ref": "#/$defs/digest"}, "primary_workspace_id": {"$ref": "#/$defs/id"}, "consulted_workspace_ids": {"type": "array", "minItems": 1, "maxItems": 17, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "outcome": {"enum": ["answer", "partial", "refuse", "investigate"]}, "reason_code": {"$ref": "#/$defs/reason_code"}, "evidence": {"type": "array", "minItems": 0, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}, "qualifications": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/public_text"}}, "readback_digest": {"$ref": "#/$defs/digest"},
    "legal_advice": {"const": false}, "property_decision": {"const": false}, "candidate_review": {"const": false}, "candidate_decision": {"const": false}, "promotion": {"const": false}, "canonical_query": {"const": false}, "provider": {"const": false}, "credential": {"const": false}, "private_data": {"const": false}, "publication": {"const": false}, "release": {"const": false}, "deployment": {"const": false}, "authority_advanced": {"const": false}
  },
  "allOf": [{"if": {"properties": {"outcome": {"enum": ["answer", "partial"]}}, "required": ["outcome"]}, "then": {"properties": {"reason_code": {"const": "ok"}}}, "else": {"properties": {"reason_code": {"not": {"const": "ok"}}}}}],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "reason_code": {"enum": ["ok", "workspace_unknown", "workspace_inactive", "registry_invalid", "identity_collision", "reference_not_declared", "reference_cycle", "workspace_binding_drift", "freshness_investigation_required", "recovery_pending"]}, "public_text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!.*[\\u0000-\\u001f])(?!/|[Ff][Ii][Ll][Ee]:)(?!.*(?:/[Hh][Oo][Mm][Ee]/|/[Oo][Pp][Tt]/|/[Tt][Mm][Pp]/|\\\\)).+$"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["workspace_id", "graph_id", "source_id", "evidence_kind", "evidence_id", "evidence_digest"], "properties": {"workspace_id": {"$ref": "#/$defs/id"}, "graph_id": {"$ref": "#/$defs/id"}, "source_id": {"$ref": "#/$defs/id"}, "evidence_kind": {"enum": ["claim", "edge"]}, "evidence_id": {"$ref": "#/$defs/id"}, "evidence_digest": {"$ref": "#/$defs/digest"}}}
  }
}
